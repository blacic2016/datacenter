# ---- API ----
API_PORT=3001
JWT_SECRET=cambiar-este-secreto-en-produccion

# Base de datos activa de la aplicación: sqlite (local) | postgres (producción)
DB_CLIENT=sqlite
SQLITE_PATH=./data/daedalous.sqlite

# Destino de sincronización SQLite -> PostgreSQL
#   postgres://usuario:clave@host:5432/daedalous   (servidor real)
#   pglite:./data/pglite                           (PostgreSQL embebido para pruebas locales)
POSTGRES_URL=pglite:./data/pglite

# Intervalo de sincronización automática en segundos (0 = desactivada)
SYNC_INTERVAL_SECONDS=0

# Usuario administrador inicial (seed)
ADMIN_EMAIL=admin@daedalous.local
ADMIN_PASSWORD=Admin123*
